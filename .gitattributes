# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files that must always use LF
*.js text eol=lf
*.css text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.yml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
